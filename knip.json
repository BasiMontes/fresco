{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "tests/steps/**/*.ts",
    "tests/*.ts",
    "cli/**/*.ts",
    "scripts/**/*.ts",
    "eslint.config.tooling.mjs",
    ".opencode/plugins/personality-reinject.js"
  ],
  "ignore": [".agents/**", "api/config/env.ts", "lib/supabase/types.ts"],
  "ignoreIssues": {
    "cli/**": ["files", "exports", "types"],
    "scripts/**": ["files", "exports", "types"],
    "tests/**": ["files", "exports", "types"],
    "supabase/**": ["files", "exports", "types"],
    "public/**": ["files"]
  },
  "ignoreDependencies": [
    "@clack/prompts",
    "@inquirer/prompts",
    "boxen",
    "cli-table3",
    "dotenv-cli",
    "figures",
    "picocolors",
    "postcss-load-config",
    "web-push",
    "yaml"
  ],
  "ignoreBinaries": ["vercel", "supabase", "psql", "playwright-cli"],
  "ignoreUnresolved": ["bun-types", "cli/doctor.ts", "cli/install.ts"],
  "rules": {
    "types": "off",
    "enumMembers": "off",
    "duplicates": "off"
  }
}
