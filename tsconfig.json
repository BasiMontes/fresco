{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "incremental": true,
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "moduleDetection": "force",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./*"],
      "@schemas": ["./api/schemas/index.ts"],
      "@schemas/*": ["./api/schemas/*"],
      "@api/*": ["./api/*"]
    },
    "resolveJsonModule": true,
    "types": ["bun-types", "node"],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "packages/*/node_modules",
    "packages/*/dist",
    ".next",
    // Boilerplate-internal e2e of the `ui` installer (synced by `bun run up`, FRESCO-857).
    // They spawn child processes with an env that lacks Next's required NODE_ENV, so they
    // do not type-check under this project's ProcessEnv. They still run under `bun test`.
    "scripts/ui-setup-e2e.test.ts",
    "scripts/ui-up-e2e.test.ts",
    // Supabase Edge Functions run on Deno, not this project's Bun/Node TS
    // program. Type-checked + linted separately by `bun run deno:check`
    // (config: supabase/functions/deno.json), enforced as the mandatory
    // `deno:check` CI job — FRESCO-375 / A4-H4.
    "supabase/functions",
    // Ambient Deno/web-push declarations used only by tsconfig.edge-tests.json
    // (type-check of the Edge Function tests) — FRESCO-840.
    "supabase/edge-tests-types"
  ]
}
