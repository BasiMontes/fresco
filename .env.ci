# .env.ci — FRESCO-310
#
# CI-only overlay appended onto `.env` by the e2e job AFTER the real secret
# `.env` is restored, so these last-wins values repoint the app + the e2e suite
# at the ephemeral local Supabase stack (`supabase start`) instead of the prod
# project. Everything NOT listed here (STRIPE_*, SENTRY_*, POSTHOG_*, VAPID_*,
# QA_* ...) keeps its value from the restored secret `.env`.
#
# These are Supabase's fixed local-dev demo constants — identical on every
# machine, issuer `supabase-demo`, no access to any real project. Safe to
# commit (published in Supabase's own docs). Verify against
# `supabase status -o env` if a CLI upgrade ever rotates them.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

