# FRESCO-837: from a linked worktree git exports GIT_DIR to this hook. Tests that run
# `git config` on throwaway repos would then write into the real .git/config.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# Framework gates, in one call: the full-repo checks pre-commit skips for speed
# (format, lint, env-var parity, and the unconditional freshness/parity safety
# nets). They live in `.husky/framework-gates.sh`, which the boilerplate updater
# SYNCS, while this hook is project-owned and never overwritten, so a gate added
# upstream lands here without rewriting your file. Read that file for what each
# gate covers and why.
#
# The `-f` guard is required: `.husky/_/h` runs this under `sh -e`, and sourcing
# a file that is not there would kill the hook.
GATES="$(dirname -- "$0")/framework-gates.sh"
if [ -f "$GATES" ]; then
  . "$GATES"
  framework_gates_pre_push || exit 1
else
  echo "⚠️  .husky/framework-gates.sh missing: framework pre-push gates SKIPPED."
  echo "   Restore it with: bun sync"
fi

# Project gate: the unit suite, kept here on purpose. This project's real
# coverage is repo-wide, not just cli/scripts, so the local push gate stays a
# real safety net and does not only rely on CI catching a broken test.
bun test
