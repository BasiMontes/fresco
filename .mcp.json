{
  "mcpServers": {
    "context7": {
      "command": "bunx",
      "args": ["-y", "@upstash/context7-mcp@4.1.1"]
    },
    "tavily": {
      "command": "bunx",
      "args": [
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "TAVILY_API_KEY",
        "--",
        "sh",
        "-c",
        "exec bunx -y mcp-remote@0.14.3 \"https://mcp.tavily.com/mcp/?tavilyApiKey=$TAVILY_API_KEY\""
      ]
    },
    "supabase": {
      "command": "bunx",
      "args": [
        "-p",
        "varlock@1.20.0",
        "varlock",
        "run",
        "--no-redact-stdout",
        "--inject",
        "vars",
        "--filter",
        "SUPABASE_ACCESS_TOKEN",
        "--",
        "bunx",
        "-y",
        "@supabase/mcp-server-supabase@0.13.0",
        "--read-only",
        "--project-ref=jdqemhewjrjuopssdurn"
      ]
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${API_KEY_21ST}"
      }
    },
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${API_KEY_GOOGLE_STITCH}"
      }
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp",
      "headers": {
        "Authorization": "Bearer ${POSTHOG_PERSONAL_API_KEY}"
      }
    }
  }
}
