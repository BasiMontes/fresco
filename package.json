{
  "name": "fresco-app",
  "type": "module",
  "version": "0.1.0",
  "description": "",
  "license": "ISC",
  "scripts": {
    "agents:setup": "bun scripts/agents-setup.ts",
    "api:sync": "bun scripts/sync-openapi.ts",
    "build": "next build",
    "db:types": "bunx supabase gen types typescript --project-id jdqemhewjrjuopssdurn > lib/supabase/types.ts",
    "dev": "next dev",
    "deno:check": "cd supabase/functions && deno lint && deno check '**/*.ts'",
    "env": "set -a; source .env; set +a",
    "format:check": "prettier --check '**/*.{json,yml,yaml,css,scss,html}' --ignore-path .prettierignore",
    "format:fix": "prettier --write '**/*.{json,yml,yaml,css,scss,html}' --ignore-path .prettierignore",
    "jira:check": "bun scripts/check-jira-setup.ts",
    "jira:closure-evidence": "bun scripts/check-closure-evidence.ts",
    "jira:sync-fields": "bun scripts/sync-jira-fields.ts",
    "jira:sync-issues": "bun scripts/sync-jira-issues.ts",
    "jira:sync-link-types": "bun scripts/sync-jira-link-types.ts",
    "jira:sync-workflows": "bun scripts/sync-jira-workflows.ts",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "onboarding": "bun scripts/onboarding.ts",
    "//opencode": "RETIRED launcher (ADR-0058), kept for reference: bash -c 'set -a; . ./.env; set +a; exec opencode \"$@\"' --",
    "prepare": "husky",
    "repo:check": "bun run adr:check && bun run format:check && bun run lint:check && bun run cycles:check && bun run knip:check && bun run types:check && bun run vars:check && bun run vars:env:check && bun run skills:check && bun run skills:registry:check && bun run agents:compat:check",
    "repo:fix": "bun run format:fix && bun run lint:fix && bun run cycles:check && bun run types:check && bun run vars:check && bun run vars:env:check && bun run skills:check && bun run skills:registry:check && bun run agents:compat:check",
    "setup:doctor": "bun cli/doctor.ts",
    "setup": "bun cli/doctor.ts --preflight && bun cli/install.ts",
    "skills:check": "bun scripts/lint-skills.ts",
    "skills:registry:check": "bun scripts/build-skill-registry.ts --check",
    "skills:registry": "bun scripts/build-skill-registry.ts",
    "start": "next start",
    "test": "bun test",
    "test:random": "bun test --parallel --randomize",
    "test:coverage": "bun scripts/check-coverage.ts",
    "test:db": "RUN_DB_INTEGRATION=1 bun test tests/db/",
    "test:e2e": "bash -c 'set -a; . ./.env; set +a; bddgen --tags \"@automatizado and not @requiere-stripe-real\" && exec playwright test'",
    "test:e2e:stripe": "bash -c 'set -a; . ./.env; set +a; bddgen --tags \"@automatizado and @requiere-stripe-real\" && exec playwright test'",
    "test:e2e:smoke": "bash -c 'set -a; . ./.env; set +a; bddgen --tags @smoke && exec playwright test'",
    "test:e2e:staging": "bash -c 'set -a; . ./.env; set +a; bddgen --tags \"@automatizado and not @requiere-captcha-off\" && PLAYWRIGHT_BASE_URL=https://fresco-pre.vercel.app exec playwright test --workers=1'",
    "test:e2e:production": "bash -c 'set -a; . ./.env; set +a; bddgen --tags \"@automatizado and not @requiere-captcha-off\" && PLAYWRIGHT_BASE_URL=https://fresco-pro.vercel.app exec playwright test --workers=1'",
    "cycles:check": "bun scripts/check-import-cycles.ts",
    "knip:check": "knip --no-progress",
    "types:check": "tsc --noEmit && bun run types:check:edge-tests",
    "types:check:edge-tests": "tsc --noEmit -p tsconfig.edge-tests.json",
    "up": "bun cli/update-boilerplate.ts",
    "vars:check": "bun scripts/lint-vars.ts",
    "vars:env:check": "bun scripts/check-vars.ts",
    "adr:check": "bun scripts/check-adrs.ts",
    "adr:reconcile": "bun scripts/adr-reconcile.ts",
    "agents:compat": "bun scripts/agent-compatibility.ts",
    "agents:compat:check": "bun scripts/agent-compatibility.ts --check",
    "//codex": "RETIRED launcher (ADR-0058), kept for reference: dotenv -o -e .env -- codex",
    "context:hydrate": "bun scripts/sync-jira-issues.ts pull --include-comments",
    "git:checks": "bun scripts/required-checks.ts",
    "git:policy": "bun scripts/git-policy.ts",
    "git:promote": "bun scripts/git-promote.ts",
    "jira:components": "bun scripts/sync-jira-components.ts",
    "jira:url": "bun scripts/atlassian-url.ts",
    "agents:schema": "bun scripts/agents-schema.ts",
    "agents:schema:check": "bun scripts/agents-schema.ts --check",
    "bootstrap:guard": "bun scripts/bootstrap-guard.ts",
    "browser:profiles": "bun scripts/browser-profiles.ts",
    "context:map": "bun scripts/context-map.ts",
    "docs:check": "bun scripts/lint-docs.ts",
    "env:set": "bun scripts/env-set.ts",
    "harness:env": "bun scripts/harness-env.ts",
    "harness:env:check": "bun scripts/harness-env.ts --check",
    "instructions:audit": "bun scripts/instructions-audit.ts",
    "instructions:check": "bun scripts/lint-instructions.ts",
    "shared:check": "bun scripts/shared-check.ts",
    "sync": "bun cli/update-boilerplate.ts",
    "tooling:lint:check": "bun scripts/tooling-check.ts lint",
    "tooling:types:check": "bun scripts/tooling-check.ts types",
    "vars:schema": "bun scripts/env-schema.ts",
    "vars:schema:check": "bun scripts/env-schema.ts --check",
    "worktree:audit": "bun scripts/worktree-audit.ts",
    "worktree:provision": "bun scripts/provision-worktree.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@inquirer/prompts": "^8.1.0",
    "@sentry/nextjs": "11.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "boneyard-js": "^1.10.0",
    "boxen": "^8.0.1",
    "class-variance-authority": "^0.7.1",
    "cli-table3": "^0.6.5",
    "clsx": "^2.1.1",
    "figures": "^6.1.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "nodemailer": "10.1.2",
    "picocolors": "^1.1.1",
    "posthog-js": "^1.438.8",
    "posthog-node": "^5.55.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.8.2",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@axe-core/playwright": "^4.13.0",
    "@clack/prompts": "^1.8.1",
    "@happy-dom/global-registrator": "^21.0.1",
    "@inquirer/prompts": "^8.7.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "boxen": "^9.0.0",
    "cli-table3": "^0.6.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "10.12.0",
    "fast-check": "^4.10.2",
    "figures": "^6.1.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "picocolors": "^1.1.1",
    "playwright-bdd": "^9.2.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "varlock": "1.20.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@humanfs/node": "^0.16.8",
    "brace-expansion": "^5.0.12",
    "dompurify": "^3.4.16",
    "katex": "^0.18.2",
    "nanoid": "^3.3.19",
    "postcss": "^8.5.29",
    "source-map-js": "^1.2.2",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{json,yml,yaml,css,scss,html}": [
      "prettier --write --ignore-path .prettierignore"
    ]
  },
  "trustedDependencies": [
    "@sentry/cli"
  ],
  "browserslist": [
    "defaults and supports es6-module"
  ]
}
